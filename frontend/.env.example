# MediFindAI Frontend - Environment Variables
# Copy to .env and fill in as needed. Vite only exposes vars prefixed with VITE_.

VITE_API_BASE_URL=http://localhost:8080/api

# Optional client-side keys for map/places UI widgets (safe to expose - restrict by domain in Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=

# Feature flags - toggle demo/fallback mode when a backend integration key isn't set
VITE_ENABLE_VOICE_SEARCH=true

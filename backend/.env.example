# ============================================================
# MediFindAI Backend - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ============================================================

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=dev

# --- Server ---
SERVER_PORT=8080

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medifindai
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# --- JWT ---
# Generate a strong random secret, e.g.: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_secret_at_least_256_bits
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- OTP ---
OTP_EXPIRY_MINUTES=10

# --- Reservation ---
RESERVATION_EXPIRY_HOURS=24

# --- AI Assistant (use ONE of these) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Google Maps / Places / Geolocation ---
GOOGLE_MAPS_API_KEY=

# --- OCR ---
GOOGLE_VISION_API_KEY=

# --- SMTP (email notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Firebase Cloud Messaging ---
FIREBASE_CONFIGURATION=
